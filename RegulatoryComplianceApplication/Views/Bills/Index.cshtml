@model IEnumerable<RegulatoryComplianceApplication.Core.Entities.Bill>

@{
    ViewData["Title"] = "Bills";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">
            <i class="bi bi-receipt me-2"></i>
            Bills
        </h2>

        <p class="text-muted mb-0">
            Manage organizational bills and payment status.
        </p>
    </div>

    @if (User.IsInRole("Administrator"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Bill
        </a>
    }

</div>

<div class="card">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th>Bill</th>
                    <th>Responsible User</th>
                    <th>Amount</th>
                    <th>Due Date</th>
                    <th>Frequency</th>
                    <th>Status</th>
                    <th class="text-center">Details</th>

                    @if (User.IsInRole("Administrator"))
                    {
                        <th class="text-center">Edit</th>
                        <th class="text-center">Delete</th>
                    }
                </tr>
            </thead>

            <tbody>

                @foreach (var bill in Model)
                {
                    <tr>

                        <td>@bill.BillName</td>

                        <td>@bill.User.FullName</td>

                        <td>@bill.Amount.ToString("C")</td>

                        <td>@bill.DueDate.ToString("dd MMM yyyy")</td>

                        <td>@bill.Frequency</td>

                        <td>

                            @if (bill.Status == RegulatoryComplianceApplication.Core.Entities.BillStatus.Paid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else if (bill.Status == RegulatoryComplianceApplication.Core.Entities.BillStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@bill.BillId"
                               class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-eye"></i>
                                View

                            </a>

                        </td>

                        @if (User.IsInRole("Administrator"))
                        {
                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@bill.BillId"
                                   class="btn btn-outline-secondary btn-sm">

                                    <i class="bi bi-pencil"></i>
                                    Edit

                                </a>

                            </td>

                            <td class="text-center">

                                <a asp-action="Delete"
                                   asp-route-id="@bill.BillId"
                                   class="btn btn-outline-danger btn-sm">

                                    <i class="bi bi-trash"></i>
                                    Delete

                                </a>

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>