@model IEnumerable<RegulatoryComplianceApplication.Core.Entities.Bill>

@{
    ViewData["Title"] = "Bills";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">
            <i class="bi bi-receipt me-2"></i>
            Bills
        </h2>

        <p class="text-muted mb-0">
            Manage organizational bills and payment status.
        </p>
    </div>

    @if (User.IsInRole("Administrator"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Bill
        </a>
    }

</div>

<form method="get" class="card mb-4">

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-7">

                <label class="form-label">Search Bill</label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by bill name..." />

            </div>

            <div class="col-md-5">

                <label class="form-label">Status</label>

                <select name="status" class="form-select">

                    <option value="">All Statuses</option>

                    @foreach (var item in Enum.GetValues<RegulatoryComplianceApplication.Core.Entities.BillStatus>())
                    {
                        <option value="@item"
                                selected="@(ViewBag.Status?.ToString() == item.ToString())">
                            @item
                        </option>
                    }

                </select>

            </div>

        </div>

        <div class="row align-items-end">

            <div class="col-md-3">

                <label class="form-label">Frequency</label>

                <select name="frequency" class="form-select">

                    <option value="">All Frequencies</option>

                    @foreach (var item in Enum.GetValues<RegulatoryComplianceApplication.Core.Entities.BillFrequency>())
                    {
                        <option value="@item"
                                selected="@(ViewBag.Frequency?.ToString() == item.ToString())">
                            @item
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label">Responsible User</label>

                <select name="userId" class="form-select">

                    <option value="">All Users</option>

                    @foreach (var user in ViewBag.Users)
                    {
                        <option value="@user.UserId"
                                selected="@(ViewBag.UserId?.ToString() == user.UserId.ToString())">
                            @user.FullName
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label">Due Date</label>

                <select name="dueFilter" class="form-select">

                    <option value="">All</option>
                    <option value="Today" selected="@(ViewBag.DueFilter == "Today")">Due Today</option>
                    <option value="Next7" selected="@(ViewBag.DueFilter == "Next7")">Next 7 Days</option>
                    <option value="Next30" selected="@(ViewBag.DueFilter == "Next30")">Next 30 Days</option>
                    <option value="Overdue" selected="@(ViewBag.DueFilter == "Overdue")">Overdue</option>

                </select>

            </div>

            <div class="col-md-3">

                <div class="d-flex justify-content-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-funnel-fill me-1"></i>
                        Filter

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Clear

                    </a>

                </div>

            </div>

        </div>

    </div>

</form>

<div class="card">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th>Bill</th>
                    <th>Responsible User</th>
                    <th>Amount</th>
                    <th>Due Date</th>
                    <th>Frequency</th>
                    <th>Status</th>
                    <th class="text-center">Details</th>

                    @if (User.IsInRole("Administrator"))
                    {
                        <th class="text-center">Edit</th>
                        <th class="text-center">Delete</th>
                    }
                </tr>
            </thead>

            <tbody>

                @foreach (var bill in Model)
                {
                    <tr>

                        <td>@bill.BillName</td>

                        <td>@bill.User.FullName</td>

                        <td>@bill.Amount.ToString("N2") SAR</td>

                        <td>@bill.DueDate.ToString("dd MMM yyyy")</td>

                        <td>@bill.Frequency</td>

                        <td>

                            @if (bill.Status == RegulatoryComplianceApplication.Core.Entities.BillStatus.Paid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else if (bill.Status == RegulatoryComplianceApplication.Core.Entities.BillStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@bill.BillId"
                               class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-eye"></i>
                                View

                            </a>

                        </td>

                        @if (User.IsInRole("Administrator"))
                        {
                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@bill.BillId"
                                   class="btn btn-outline-secondary btn-sm">

                                    <i class="bi bi-pencil"></i>
                                    Edit

                                </a>

                            </td>

                            <td class="text-center">

                                <a asp-action="Delete"
                                   asp-route-id="@bill.BillId"
                                   class="btn btn-outline-danger btn-sm">

                                    <i class="bi bi-trash"></i>
                                    Delete

                                </a>

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>