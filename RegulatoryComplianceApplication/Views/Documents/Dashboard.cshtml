@model RegulatoryComplianceApplication.Web.ViewModels.DashboardViewModel

<h1>Dashboard</h1>
<div class="row">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Valid</h5>
                <p class="card-text fs-2">@Model.ValidCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Expiring Soon</h5>
                <p class="card-text fs-2">@Model.ExpiringSoonCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Expired</h5>
                <p class="card-text fs-2">@Model.ExpiredCount</p>
            </div>
        </div>
    </div>
    <canvas id="statusChart" style="max-width: 400px;"></canvas>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('statusChart'), {
        type: 'pie',
        data: {
        labels: ['Valid', 'Expiring Soon', 'Expired'],
        datasets: [{
        data: [@Model.ValidCount, @Model.ExpiringSoonCount, @Model.ExpiredCount],
        backgroundColor: ['#198754', '#ffc107', '#dc3545']
        }]
        }
        });
    </script>
</div>