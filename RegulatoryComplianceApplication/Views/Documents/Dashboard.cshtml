@model RegulatoryComplianceApplication.Web.ViewModels.DashboardViewModel

<h1>Dashboard</h1>
<div class="row">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Valid</h5>
                <p class="card-text fs-2">@Model.ValidCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Expiring Soon</h5>
                <p class="card-text fs-2">@Model.ExpiringSoonCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger mb-3">
            <div class="card-body">
                <h5 class="card-title">Expired</h5>
                <p class="card-text fs-2">@Model.ExpiredCount</p>
            </div>
        </div>
    </div>
</div>