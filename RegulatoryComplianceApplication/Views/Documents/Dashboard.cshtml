@model RegulatoryComplianceApplication.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">

    <h2 class="fw-bold">
        <i class="bi bi-speedometer2 me-2"></i>
        Dashboard
    </h2>

    <p class="text-muted mb-0">
        Overview of your organization's regulatory compliance status.
    </p>

</div>

<div class="row g-4">

    <div class="col-lg-4">

        <div class="card h-100">

            <div class="card-body text-center py-4">

                <i class="bi bi-check-circle-fill text-success display-5"></i>

                <h5 class="mt-3 mb-2">
                    Valid Documents
                </h5>

                <h1 class="display-5 fw-bold text-success mb-0">
                    @Model.ValidCount
                </h1>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card h-100">

            <div class="card-body text-center py-4">

                <i class="bi bi-exclamation-triangle-fill text-warning display-5"></i>

                <h5 class="mt-3 mb-2">
                    Expiring Soon
                </h5>

                <h1 class="display-5 fw-bold text-warning mb-0">
                    @Model.ExpiringSoonCount
                </h1>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card h-100">

            <div class="card-body text-center py-4">

                <i class="bi bi-x-circle-fill text-danger display-5"></i>

                <h5 class="mt-3 mb-2">
                    Expired
                </h5>

                <h1 class="display-5 fw-bold text-danger mb-0">
                    @Model.ExpiredCount
                </h1>

            </div>

        </div>

    </div>

</div>

@if (User.IsInRole("Administrator"))
{
    <div class="card mt-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-file-earmark-text me-2"></i>
                Reports
            </h5>

        </div>

        <div class="card-body">

            <p class="text-muted mb-3">
                Generate management reports for documents and bills.
            </p>

            <a asp-action="ExportDocumentsPdf"
               asp-controller="Documents"
               class="btn btn-outline-danger me-2">

                <i class="bi bi-file-earmark-pdf me-1"></i>
                Documents PDF

            </a>

            <!-- We'll add Excel here -->

        </div>

    </div>
}

<div class="row mt-5 g-4">

    <div class="col-lg-6">

        <div class="card h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-pie-chart-fill me-2"></i>
                    Status Distribution
                </h5>

            </div>

            <div class="card-body d-flex justify-content-center align-items-center">

                <div id="statusDonutChart"
                     style="width:100%; max-width:340px;">
                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-6">

        <div class="card h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    <i class="bi bi-bar-chart-fill me-2"></i>
                    Status Comparison
                </h5>

            </div>

            <div class="card-body d-flex justify-content-center align-items-center">

                <div id="statusBarChart"
                     style="width:100%; max-width:500px;">
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <script>

        const validCount = @Model.ValidCount;
        const expiringSoonCount = @Model.ExpiringSoonCount;
        const expiredCount = @Model.ExpiredCount;

        // ===========================
        // Doughnut Chart
        // ===========================

        var donutOptions = {

        chart: {
        type: 'donut',
        height: 280,
        toolbar: {
        show: false
        }
        },

        series: [

        validCount,

        expiringSoonCount,

        expiredCount

        ],

        labels: [

        'Valid',

        'Expiring Soon',

        'Expired'

        ],

        colors: [

        '#198754',

        '#FFC107',

        '#DC3545'

        ],

        legend: {

        position: 'bottom'

        },

        stroke: {

        width: 0

        },

        dataLabels: {

        enabled: true

        }

        };

        new ApexCharts(
        document.querySelector("#statusDonutChart"),
        donutOptions
        ).render();


        // ===========================
        // Bar Chart
        // ===========================

        var barOptions = {

        chart: {

        type: 'bar',

        height: 280,

        toolbar: {

        show: false

        }

        },

        series: [

        {

        name: 'Documents',

        data: [

        validCount,

        expiringSoonCount,

        expiredCount

        ]

        }

        ],

        xaxis: {

        categories: [

        'Valid',

        'Expiring Soon',

        'Expired'

        ]

        },

        colors: [

        '#005EB8'

        ],

        plotOptions: {

        bar: {

        borderRadius: 6,

        columnWidth: '45%',

        distributed: false

        }

        },

        grid: {

        borderColor: '#ECECEC'

        },

        dataLabels: {

        enabled: false

        },

        legend: {

        show: false

        },

        yaxis: {

        min: 0,

        forceNiceScale: true

        }

        };

        new ApexCharts(
        document.querySelector("#statusBarChart"),
        barOptions
        ).render();

    </script>
}