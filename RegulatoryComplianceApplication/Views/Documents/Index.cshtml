@model List<RegulatoryComplianceApplication.Web.ViewModels.DocumentListViewModel>

@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-folder2-open me-2"></i>
            Documents
        </h2>

        <p class="text-muted mb-0">
            Manage regulatory compliance documents and renew expiring records.
        </p>
    </div>

    @if (User.IsInRole("Administrator"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Add Document
        </a>
    }

</div>

<form method="get" class="card mb-4">

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-7">

                <label class="form-label">Search</label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search by title or document number..." />

            </div>

            <div class="col-md-5">

                <label class="form-label">Status</label>

                <select name="status" class="form-select">

                    <option value="">All Statuses</option>

                    <option value="Valid"
                            selected="@(ViewBag.Status == "Valid")">
                        Valid
                    </option>

                    <option value="Expiring Soon"
                            selected="@(ViewBag.Status == "Expiring Soon")">
                        Expiring Soon
                    </option>

                    <option value="Expired"
                            selected="@(ViewBag.Status == "Expired")">
                        Expired
                    </option>

                    <option value="No Expiry"
                            selected="@(ViewBag.Status == "No Expiry")">
                        No Expiry
                    </option>

                </select>

            </div>

        </div>

        <div class="row align-items-end">

            <div class="col-md-4">

                <label class="form-label">Document Type</label>

                <select name="documentTypeId"
                        class="form-select">

                    <option value="">All Types</option>

                    @foreach (var type in ViewBag.DocumentTypes)
                    {
                        <option value="@type.DocumentTypeId"
                                selected="@(ViewBag.DocumentTypeId?.ToString() == type.DocumentTypeId.ToString())">

                            @type.TypeName

                        </option>
                    }

                </select>

            </div>

            <div class="col-md-4">

                <label class="form-label">Responsible User</label>

                <select name="userId"
                        class="form-select">

                    <option value="">All Users</option>

                    @foreach (var user in ViewBag.Users)
                    {
                        <option value="@user.UserId"
                                selected="@(ViewBag.UserId?.ToString() == user.UserId.ToString())">

                            @user.FullName

                        </option>
                    }

                </select>

            </div>

            <div class="col-md-4">

                <div class="d-flex justify-content-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-funnel-fill me-1"></i>
                        Filter

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Clear

                    </a>

                </div>

            </div>

        </div>

    </div>

</form>

<div class="card">

    <div class="card-body p-0">

        <table class="table table-hover align-middle mb-0">

            <thead>
                <tr>
                    <th>Title</th>
                    <th>Document Number</th>
                    <th>Responsible User</th>
                    <th>Expiry Date</th>
                    <th>Status</th>
                    <th class="text-center">Details</th>

                    @if (User.IsInRole("Administrator"))
                    {
                        <th class="text-center">Edit</th>
                        <th class="text-center">Renew</th>
                        <th class="text-center">Delete</th>
                    }
                    else
                    {
                        <th class="text-center">Edit</th>
                        <th class="text-center">Renew</th>
                    }
                </tr>
            </thead>

            <tbody>

                @foreach (var doc in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            @doc.Title
                        </td>

                        <td>
                            @doc.DocumentNumber
                        </td>

                        <td>
                            @doc.ResponsibleUser
                        </td>

                        <td>
                            @(doc.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")
                        </td>

                        <td>

                            @if (doc.Status == "Expired")
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Expired
                                </span>
                            }
                            else if (doc.Status == "Expiring Soon")
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Expiring Soon
                                </span>
                            }
                            else if (doc.Status == "No Expiry")
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-infinity me-1"></i>
                                    No Expiry
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Valid
                                </span>
                            }

                        </td>

                        <td class="text-center">

                            <a asp-action="Details"
                               asp-route-id="@doc.DocumentId"
                               class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-eye me-1"></i>
                                View

                            </a>

                        </td>
                        <td class="text-center">

                            
                                <a asp-action="Edit"
                                   asp-route-id="@doc.DocumentId"
                                   class="btn btn-outline-secondary btn-sm">

                                    <i class="bi bi-pencil"></i>
                                    Edit

                                </a>
                            

                        </td>

                        @if (User.IsInRole("Administrator"))
                        {
                            <td class="text-center">

                                <a asp-action="Delete"
                                   asp-route-id="@doc.DocumentId"
                                   class="btn btn-outline-warning btn-sm">

                                    <i class="bi bi-archive me-1"></i>
                                    Delete

                                </a>

                            </td>
                        }

                        <td class="text-center">

                            <a asp-action="Renew"
                               asp-route-id="@doc.DocumentId"
                               class="btn btn-outline-success btn-sm">

                                <i class="bi bi-arrow-repeat"></i>
                                Renew

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>