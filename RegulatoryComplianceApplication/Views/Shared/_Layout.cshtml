<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Regulatory Compliance System</title>

    <link rel="icon"
          type="image/x-icon"
          href="~/favicon.ico"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RegulatoryComplianceApplication.styles.css"
          asp-append-version="true" />
</head>

<body style="background:#f4f6fb;">

    <header class="py-3">

        <div class="container-fluid px-4">

            <nav class="navbar navbar-expand-lg bg-white rounded-4 shadow-sm px-4 py-3">

                <a class="navbar-brand d-flex align-items-center fw-bold fs-5"
                   asp-controller="Documents"
                   asp-action="Dashboard">

                    <img src="~/images/BTGroupLogo.png"
                         asp-append-version="true"
                         height="42"
                         class="me-3"
                         alt="Logo" />

                    <div>

                        <div>Regulatory Compliance</div>

                        <small class="text-muted fw-normal">
                            Management System
                        </small>

                    </div>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <ul class="navbar-nav mx-auto">

                            <li class="nav-item mx-1">
                                <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                   asp-controller="Documents"
                                   asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-2"></i>
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item mx-1">
                                <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                   asp-controller="Documents"
                                   asp-action="Index">
                                    <i class="bi bi-folder2-open me-2"></i>
                                    Documents
                                </a>
                            </li>

                            <li class="nav-item mx-1">
                                <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                   asp-controller="Bills"
                                   asp-action="Index">
                                    <i class="bi bi-receipt me-2"></i>
                                    Bills
                                </a>
                            </li>

                            <li class="nav-item mx-1">
                                <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                   asp-controller="Calendar"
                                   asp-action="Index">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    Calendar
                                </a>
                            </li>

                            <li class="nav-item mx-1">
                                <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                   asp-controller="Assistant"
                                   asp-action="Index">
                                    <i class="bi bi-robot me-2"></i>
                                    Assistant
                                </a>
                            </li>

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item mx-1">
                                    <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                       asp-controller="Users"
                                       asp-action="Index">
                                        <i class="bi bi-people me-2"></i>
                                        Users
                                    </a>
                                </li>

                                <li class="nav-item mx-1">
                                    <a class="nav-link px-3 py-2 rounded-pill fw-semibold"
                                       asp-controller="DocumentTypes"
                                       asp-action="Index">
                                        <i class="bi bi-tags me-2"></i>
                                        Types
                                    </a>
                                </li>
                            }

                        </ul>

                        <div class="d-flex align-items-center">

                            <div class="bg-light rounded-circle p-2 me-3">

                                @await Component.InvokeAsync("NotificationBell")

                            </div>

                            <div class="d-flex align-items-center bg-light rounded-pill px-3 py-2 me-3">

                                <i class="bi bi-person-circle fs-5 me-2 text-primary"></i>

                                <span class="fw-semibold">

                                    @User.Identity!.Name

                                </span>

                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button class="btn btn-danger rounded-pill px-4">

                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Logout

                                </button>

                            </form>

                        </div>

                    }

                </div>

            </nav>

        </div>

    </header>

    <div class="container-fluid px-4 pb-4">

        <div class="bg-white rounded-4 shadow-sm p-4">

            <main role="main">

                @RenderBody()

            </main>

        </div>

    </div>

    <footer class="text-center text-muted small pb-4">

        © @DateTime.Now.Year
        Regulatory Compliance System

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>